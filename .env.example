# Copy this file to .env and fill in your own values. Never commit .env.

# Neon / Postgres: direct connection (migrations, seed)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"
# Neon / Postgres: pooled connection (app runtime)
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=verify-full"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
