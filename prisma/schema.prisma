// FixNear database design
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums (fixed values mattum allowed) ----------

enum Role {
  CUSTOMER
  PROVIDER
}

enum BookingStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

// ---------- Tables ----------

// Login panra ellaarum (customer + provider)
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique // Clerk user-oda link
  name      String
  email     String   @unique
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())

  providerProfile ProviderProfile? // one-to-one: max oru profile
  bookings        Booking[]        // one-to-many: customer-a panna bookings
}

// Provider-oda extra details
model ProviderProfile {
  id              String  @id @default(cuid())
  userId          String  @unique // @unique = oru user-ku oru profile dhaan
  category        String  // Electrician, Plumber...
  area            String
  bio             String?
  experienceYears Int     @default(0)
  phone           String

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  services Service[]
  bookings Booking[]
}

// Provider enna velai pannuvaar, evlo rate
model Service {
  id           String @id @default(cuid())
  providerId   String
  title        String
  price        Int    // rupees-la (₹300 = 300)
  durationMins Int

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

// Customer panna booking request
model Booking {
  id             String        @id @default(cuid())
  customerId     String
  providerId     String
  serviceId      String
  priceAtBooking Int           // snapshot: book panna nerathula price
  scheduledAt    DateTime
  address        String
  note           String?
  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(UNPAID)
  createdAt      DateTime      @default(now())

  customer User            @relation(fields: [customerId], references: [id])
  provider ProviderProfile @relation(fields: [providerId], references: [id])
  service  Service         @relation(fields: [serviceId], references: [id])
  review   Review?
}

// Velai mudinja apram feedback (oru booking-ku oru review)
model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  rating    Int      // 1 to 5
  comment   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
